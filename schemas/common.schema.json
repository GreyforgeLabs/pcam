{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.greyforge.tech/pcam/v3/common.schema.json",
  "title": "PCAM v3 common definitions",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
    },
    "u64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "i64": {
      "type": "integer",
      "minimum": -9223372036854775808,
      "maximum": 9223372036854775807
    },
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "required": ["literal"],
          "properties": {"literal": {}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["ref"],
          "properties": {"ref": {"type": "string", "minLength": 1}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["op", "args"],
          "properties": {
            "op": {
              "enum": [
                "and", "or", "not", "xor", "eq", "ne", "lt", "lte", "gt", "gte",
                "add", "sub", "mul", "div", "mod", "min", "max", "clamp", "abs",
                "contains", "intersects", "subset", "union", "difference", "if", "coalesce"
              ]
            },
            "args": {
              "type": "array",
              "items": {"$ref": "#/$defs/expression"},
              "maxItems": 64
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "extensionMap": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 3,
        "maxLength": 128,
        "pattern": "^[A-Za-z][A-Za-z0-9-]*(\\.[A-Za-z][A-Za-z0-9-]*)+$"
      },
      "additionalProperties": {
        "type": "object",
        "required": ["requirement", "authoritative", "payload"],
        "properties": {
          "requirement": {"enum": ["REQUIRED", "OPTIONAL"]},
          "authoritative": {"type": "boolean"},
          "omission_preserves_authority": {"type": "boolean"},
          "schema_id": {"type": "string", "minLength": 1, "maxLength": 512},
          "canonical_encoding": {"$ref": "#/$defs/identifier"},
          "validation_id": {"$ref": "#/$defs/identifier"},
          "runtime_semantics_id": {"$ref": "#/$defs/identifier"},
          "ordering_id": {"$ref": "#/$defs/identifier"},
          "fault_behavior_id": {"$ref": "#/$defs/identifier"},
          "snapshot_schema_id": {"type": "string", "minLength": 1, "maxLength": 512},
          "rollback_behavior_id": {"$ref": "#/$defs/identifier"},
          "determinism_vectors": {
            "type": "array",
            "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "minItems": 1,
            "maxItems": 1024,
            "uniqueItems": true
          },
          "payload": {}
        },
        "allOf": [
          {
            "if": {"properties": {"requirement": {"const": "OPTIONAL"}}, "required": ["requirement"]},
            "then": {
              "required": ["omission_preserves_authority"],
              "properties": {
                "authoritative": {"const": false},
                "omission_preserves_authority": {"const": true}
              }
            }
          },
          {
            "if": {"properties": {"authoritative": {"const": true}}, "required": ["authoritative"]},
            "then": {
              "required": [
                "schema_id",
                "canonical_encoding",
                "validation_id",
                "runtime_semantics_id",
                "ordering_id",
                "fault_behavior_id",
                "snapshot_schema_id",
                "rollback_behavior_id",
                "determinism_vectors"
              ],
              "properties": {"requirement": {"const": "REQUIRED"}}
            }
          }
        ],
        "additionalProperties": false
      }
    }
  }
}
