{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.greyforge.tech/pcam/v3/common.schema.json",
  "title": "PCAM v3 common definitions",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
    },
    "u64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "i64": {
      "type": "integer",
      "minimum": -9223372036854775808,
      "maximum": 9223372036854775807
    },
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "required": ["literal"],
          "properties": {"literal": {}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["ref"],
          "properties": {"ref": {"type": "string", "minLength": 1}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["op", "args"],
          "properties": {
            "op": {
              "enum": [
                "and", "or", "not", "xor", "eq", "ne", "lt", "lte", "gt", "gte",
                "add", "sub", "mul", "div", "mod", "min", "max", "clamp", "abs",
                "contains", "intersects", "subset", "union", "difference", "if", "coalesce"
              ]
            },
            "args": {
              "type": "array",
              "items": {"$ref": "#/$defs/expression"},
              "maxItems": 64
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "assignment": {
      "type": "object",
      "required": ["target", "value"],
      "properties": {
        "target": {"type": "string", "minLength": 1, "maxLength": 256},
        "value": {"$ref": "#/$defs/expression"}
      },
      "additionalProperties": false
    },
    "effect": {
      "type": "object",
      "required": ["effect_type", "authoritative", "payload"],
      "properties": {
        "effect_type": {"$ref": "#/$defs/identifier"},
        "effect_class": {"$ref": "#/$defs/identifier"},
        "authoritative": {"type": "boolean"},
        "reducer": {"enum": ["SUM", "MIN", "MAX", "SET_UNION", "ORDERED", "FIRST", "LAST", "EXCLUSIVE", "CUSTOM_DETERMINISTIC"]},
        "target": {"type": ["string", "integer"]},
        "priority": {"$ref": "#/$defs/i64"},
        "payload": {}
      },
      "additionalProperties": false
    },
    "effectTemplate": {
      "allOf": [
        {"$ref": "#/$defs/effect"},
        {"required": ["effect_class", "reducer"]}
      ]
    },
    "claim": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "resource", "amount"],
          "properties": {
            "kind": {"const": "RESOURCE"},
            "resource": {"$ref": "#/$defs/identifier"},
            "amount": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "slot", "amount"],
          "properties": {
            "kind": {"enum": ["ACTION_SLOT", "CHILD_SLOT"]},
            "slot": {"$ref": "#/$defs/identifier"},
            "amount": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "key", "amount"],
          "properties": {
            "kind": {"enum": ["CAPACITY", "EXCLUSIVE_KEY"]},
            "key": {"$ref": "#/$defs/identifier"},
            "amount": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615}
          },
          "additionalProperties": false
        }
      ]
    },
    "phaseRange": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 0, "maximum": 23},
        {"type": "integer", "minimum": 1, "maximum": 24}
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "pcam24Profile": {
      "type": "object",
      "required": ["lifecycle", "projection", "tags"],
      "properties": {
        "lifecycle": {"enum": ["TERMINATE", "LOOP", "CLAMP"]},
        "projection": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "type": "object",
            "required": ["node", "step_range", "phase_range"],
            "properties": {
              "node": {"$ref": "#/$defs/identifier"},
              "step_range": {
                "type": "array",
                "prefixItems": [
                  {"$ref": "#/$defs/u64"},
                  {"$ref": "#/$defs/u64"}
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              },
              "phase_range": {"$ref": "#/$defs/phaseRange"}
            },
            "additionalProperties": false
          }
        },
        "tags": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/identifier"},
          "additionalProperties": {
            "type": "array",
            "items": {"$ref": "#/$defs/phaseRange"},
            "maxItems": 24
          }
        }
      },
      "additionalProperties": false
    },
    "extensionMap": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 3,
        "maxLength": 128,
        "pattern": "^[A-Za-z][A-Za-z0-9-]*(\\.[A-Za-z][A-Za-z0-9-]*)+$"
      },
      "additionalProperties": {
        "type": "object",
        "required": ["requirement", "authoritative", "payload"],
        "properties": {
          "requirement": {"enum": ["REQUIRED", "OPTIONAL"]},
          "authoritative": {"type": "boolean"},
          "omission_preserves_authority": {"type": "boolean"},
          "schema_id": {"type": "string", "minLength": 1, "maxLength": 512},
          "canonical_encoding": {"$ref": "#/$defs/identifier"},
          "validation_id": {"$ref": "#/$defs/identifier"},
          "runtime_semantics_id": {"$ref": "#/$defs/identifier"},
          "ordering_id": {"$ref": "#/$defs/identifier"},
          "fault_behavior_id": {"$ref": "#/$defs/identifier"},
          "snapshot_schema_id": {"type": "string", "minLength": 1, "maxLength": 512},
          "rollback_behavior_id": {"$ref": "#/$defs/identifier"},
          "determinism_vectors": {
            "type": "array",
            "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "minItems": 1,
            "maxItems": 1024,
            "uniqueItems": true
          },
          "payload": {}
        },
        "allOf": [
          {
            "if": {"properties": {"requirement": {"const": "OPTIONAL"}}, "required": ["requirement"]},
            "then": {
              "required": ["omission_preserves_authority"],
              "properties": {
                "authoritative": {"const": false},
                "omission_preserves_authority": {"const": true}
              }
            }
          },
          {
            "if": {"properties": {"authoritative": {"const": true}}, "required": ["authoritative"]},
            "then": {
              "required": [
                "schema_id",
                "canonical_encoding",
                "validation_id",
                "runtime_semantics_id",
                "ordering_id",
                "fault_behavior_id",
                "snapshot_schema_id",
                "rollback_behavior_id",
                "determinism_vectors"
              ],
              "properties": {"requirement": {"const": "REQUIRED"}}
            }
          }
        ],
        "additionalProperties": false
      }
    }
  }
}
